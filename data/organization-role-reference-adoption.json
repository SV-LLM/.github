      "rule": "declared_substitutions",
      "reference_sha256": "sha256:5ce20fd990d72980aa835cd2de073a4141bacb33ec995d0ea229c42f8cf198c5",
      "local_sha256": "sha256:33542bfacf802e80fa2fdd2ffb5310e108d5fada207e947a6053b061c10cafbc",
      "substitutions": [
        {
          "reference": "OWNER_REPOSITORY = \"StegVerse-org/.github\"",
          "local": "# SV-LLM declared substitution (data/organization-role-reference-adoption.json):\n# the organization identity is read from this organization's own boundary\n# document instead of being written into the reference logic.\nOWNER_REPOSITORY = json.loads(BOUNDARY.read_text(encoding=\"utf-8\"))[\"owner_repository\"]\nORGANIZATION = json.loads(BOUNDARY.read_text(encoding=\"utf-8\"))[\"organization\"]",
          "count": 1,
          "why": "the reference names its own repository; SV-LLM reads owner_repository and organization from org-runtime/interlock-intr.json, which the SDK's resolve_organization_ingress already requires to agree (owner_repository == organization + '/.github')"
        },
        {
          "reference": ": \"StegVerse-org\",",
          "local": ": ORGANIZATION,",
          "count": 5,
          "why": "the five result and payload fields that name the receiving organization"
        },
        {
          "reference": "boundary()[\"egress\"][\"capability_destination_bindings\"]",
          "local": "(boundary()[\"egress\"].get(\"capability_destination_bindings\") or [])",
          "count": 1,
          "why": "SV-LLM declares no outbound destination binding (tests/test_intr_destination_capability.py); without one the reference raised KeyError after the refusal was recorded, so a NON-ALLOW now stays the six-field receipt with disposition_delivery NON_ALLOW_DISPOSITION_BINDING_ABSENT, the reference's own outcome for an absent binding"
        }
      ]
    }
